# SkatePlan backend environment template.
# Copy to .env and fill in real values. NEVER commit the real .env (it is gitignored).

# --- Required (no default; app will not start without these) ---
# PostgreSQL connection string, e.g. postgresql+psycopg://user:password@host:5432/dbname
DATABASE_URL=

# Secret key used to sign JWT access tokens. Generate a long random value, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# --- Optional (defaults shown; override only if needed) ---
# JWT signing algorithm.
ALGORITHM=HS256
# Access-token lifetime in minutes (default 1440 = 24h).
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Note ---
# CORS allowed origins are currently hard-coded in app/main.py
# (public origin + localhost dev). Update them there when deploying to a new
# public host; they are not read from the environment.
